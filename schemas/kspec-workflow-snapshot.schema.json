{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanjeevkumarraob/kspec/schemas/kspec-workflow-snapshot.schema.json",
  "title": "kspec Workflow Snapshot",
  "description": "A derived, portable view of a kspec workflow. Repository artifacts remain authoritative; this document does not grant execution or approval authority.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "projectRoot",
    "activeSpec",
    "stage",
    "artifacts",
    "progress",
    "next",
    "freshness"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "kspec-workflow-snapshot"
    },
    "projectRoot": {
      "type": "string",
      "const": "."
    },
    "activeSpec": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "path", "format"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "format": {
              "oneOf": [
                { "type": "string", "enum": ["v3", "legacy"] },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "stage": {
      "type": "string",
      "enum": ["uninitialized", "requirements", "design", "tasks", "build", "verify", "complete"]
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "progress": {
      "$ref": "#/$defs/progress"
    },
    "next": {
      "type": "object",
      "required": ["candidates"],
      "properties": {
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate" }
        }
      },
      "additionalProperties": false
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "artifacts": {
      "type": "object",
      "required": ["requirements", "design", "tasks", "context"],
      "properties": {
        "requirements": { "type": ["string", "null"] },
        "design": { "type": ["string", "null"] },
        "tasks": { "type": ["string", "null"] },
        "context": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "taskStats": {
      "type": "object",
      "required": ["total", "done", "remaining"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "done": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "chunk": {
      "type": "object",
      "required": ["number", "name", "total", "done", "remaining"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "total": { "type": "integer", "minimum": 0 },
        "done": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["tasks", "chunks", "currentChunk", "currentTask"],
      "properties": {
        "tasks": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/taskStats" }
          ]
        },
        "chunks": {
          "type": "array",
          "items": { "$ref": "#/$defs/chunk" }
        },
        "currentChunk": { "type": ["string", "null"] },
        "currentTask": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["id", "command", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": ["algorithm", "value", "inputs"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
